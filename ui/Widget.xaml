<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aura" Width="300" Height="294" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        FontFamily="Segoe UI" Foreground="White" UseLayoutRounding="True">
  <Window.Resources>
    <LinearGradientBrush x:Key="AuraGrad" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2E9BD6" Offset="0"/><GradientStop Color="#8A4FD1" Offset="1"/></LinearGradientBrush>
    <Style TargetType="ContextMenu">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="#F2222226" CornerRadius="10" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="5" Margin="6">
              <StackPanel IsItemsHost="True"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="MenuItem">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="B" CornerRadius="6" Padding="10,7,18,7" Background="Transparent">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="Chk" Text="✓" Width="18" Visibility="Hidden"/>
                <ContentPresenter ContentSource="Header"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="B" Property="Background" Value="{StaticResource AuraGrad}"/></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chk" Property="Visibility" Value="Visible"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Track" TargetType="Ellipse">
      <Setter Property="Width" Value="72"/><Setter Property="Height" Value="72"/>
      <Setter Property="StrokeThickness" Value="7"/><Setter Property="Stroke" Value="#26FFFFFF"/>
    </Style>
    <!-- Anel: o traço tem o comprimento da circunferência (29.17 = pi*(72-7)/7); o offset define quanto aparece -->
    <Style x:Key="Ring" TargetType="Ellipse">
      <Setter Property="Width" Value="72"/><Setter Property="Height" Value="72"/>
      <Setter Property="StrokeThickness" Value="7"/>
      <Setter Property="StrokeDashArray" Value="29.17 29.17"/><Setter Property="StrokeDashOffset" Value="29.17"/>
      <Setter Property="StrokeDashCap" Value="Round"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="-90"/></Setter.Value></Setter>
    </Style>
    <Style x:Key="Val" TargetType="TextBlock">
      <Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Lbl" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#A6FFFFFF"/>
      <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="Margin" Value="0,7,0,0"/>
    </Style>
  </Window.Resources>

  <!-- Vidro translúcido sem desfoque: no Windows 10 o desfoque do sistema é sempre retangular e estragaria os cantos arredondados -->
  <Border CornerRadius="22" Background="#A618181C" BorderBrush="#33FFFFFF" BorderThickness="1">
    <StackPanel Margin="20,10,20,16">
      <TextBlock x:Name="Clock" Text="00:00" FontSize="66" FontWeight="Light" HorizontalAlignment="Center"/>
      <TextBlock x:Name="Date" Text="" FontSize="13.5" Foreground="#C8FFFFFF" HorizontalAlignment="Center" Margin="0,-6,0,18"/>
      <UniformGrid Columns="3">
        <StackPanel>
          <Grid><Ellipse Style="{StaticResource Track}"/><Ellipse x:Name="CpuRing" Style="{StaticResource Ring}" Stroke="#64D2FF"/><TextBlock x:Name="CpuText" Style="{StaticResource Val}" Text="0%"/></Grid>
          <TextBlock Style="{StaticResource Lbl}" Text="CPU"/>
        </StackPanel>
        <StackPanel>
          <Grid><Ellipse Style="{StaticResource Track}"/><Ellipse x:Name="RamRing" Style="{StaticResource Ring}" Stroke="#BF5AF2"/><TextBlock x:Name="RamText" Style="{StaticResource Val}" Text="0%"/></Grid>
          <TextBlock x:Name="RamLabel" Style="{StaticResource Lbl}" Text="RAM"/>
        </StackPanel>
        <StackPanel>
          <Grid><Ellipse Style="{StaticResource Track}"/><Ellipse x:Name="TempRing" Style="{StaticResource Ring}" Stroke="#30D158"/><TextBlock x:Name="TempText" Style="{StaticResource Val}" Text="—"/></Grid>
          <TextBlock Style="{StaticResource Lbl}" Text="GPU °C"/>
        </StackPanel>
      </UniformGrid>
      <Border Background="#1AFFFFFF" CornerRadius="12" Margin="0,18,0,0" Padding="14,9">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="Down" Text="↓ 0 KB/s" FontSize="12.5" Foreground="#64D2FF"/>
          <TextBlock x:Name="Up" Grid.Column="1" Text="↑ 0 KB/s" FontSize="12.5" Foreground="#BF5AF2"/>
          <TextBlock x:Name="Today" Grid.Column="2" Text="" FontSize="12.5" Foreground="#A6FFFFFF"/>
        </Grid>
      </Border>
    </StackPanel>
  </Border>
</Window>
