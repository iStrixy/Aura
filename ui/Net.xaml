<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aura · Rede" Width="1080" Height="720" MinWidth="880" MinHeight="560"
        WindowStyle="None" Background="Transparent" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Foreground="White" UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb"><Border CornerRadius="3" Background="#38FFFFFF"/></ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Cores do Aura (as mesmas dos anéis do widget) -->
    <LinearGradientBrush x:Key="AuraGrad" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#2E9BD6" Offset="0"/><GradientStop Color="#8A4FD1" Offset="1"/>
    </LinearGradientBrush>

    <!-- Botões da janela: ícone fino num quadradinho arredondado; ao passar o mouse ganham a cor do Aura.
         Background = cor do brilho (minimizar = ciano da CPU, maximizar = roxo da RAM, fechar = vermelho) -->
    <Style x:Key="WinBtn" TargetType="Button">
      <Setter Property="Width" Value="30"/><Setter Property="Height" Value="28"/><Setter Property="Margin" Value="4,0,0,0"/>
      <Setter Property="Focusable" Value="False"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#B3FFFFFF"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border CornerRadius="8" Background="#0FFFFFFF"/>
              <Border x:Name="Glow" CornerRadius="8" Background="{TemplateBinding Background}" Opacity="0"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Glow" Property="Opacity" Value="0.9"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Glow" Property="Opacity" Value="0.6"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Item da barra lateral -->
    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#D9FFFFFF"/><Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Margin" Value="0,0,0,3"/><Setter Property="Focusable" Value="False"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="B" CornerRadius="8" Padding="11,8" Background="#00FFFFFF">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="I" Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28" VerticalAlignment="Center" Foreground="#64D2FF"/>
                <ContentPresenter VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#14FFFFFF"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="B" Property="Background" Value="{StaticResource AuraGrad}"/>
                <Setter TargetName="I" Property="Foreground" Value="White"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Pill" TargetType="Button">
      <Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="12.5"/><Setter Property="Focusable" Value="False"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" CornerRadius="14" Padding="16,6" Background="{StaticResource AuraGrad}"><ContentPresenter/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.85"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Background" Value="#33FFFFFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Campos de texto escuros -->
    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Foreground" Value="White"/><Setter Property="CaretBrush" Value="White"/><Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="B" CornerRadius="9" Background="#1AFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" Padding="10,7">
              <ScrollViewer x:Name="PART_ContentHost"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#64D2FF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PField" TargetType="PasswordBox">
      <Setter Property="Foreground" Value="White"/><Setter Property="CaretBrush" Value="White"/><Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Border x:Name="B" CornerRadius="9" Background="#1AFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" Padding="10,7">
              <ScrollViewer x:Name="PART_ContentHost"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#64D2FF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="CornerRadius" Value="14"/><Setter Property="Background" Value="#14FFFFFF"/><Setter Property="Padding" Value="18,14"/>
    </Style>
    <Style x:Key="Cap" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#8CFFFFFF"/>
    </Style>

    <!-- Linha explicada: bolinha de cor, título, detalhe técnico, explicação simples, selo -->
    <DataTemplate x:Key="RowT">
      <Border Margin="0,0,0,8" Padding="16,12" CornerRadius="12" Background="#14FFFFFF">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Ellipse Width="9" Height="9" Fill="{Binding Color}" VerticalAlignment="Top" Margin="0,6,13,0"/>
          <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Sub}" FontSize="11.5" Foreground="#8CFFFFFF" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Text}" FontSize="12.5" Foreground="#D9FFFFFF" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="18"/>
          </StackPanel>
          <Border Grid.Column="2" CornerRadius="9" Padding="9,2,9,3" Margin="12,0,0,0" VerticalAlignment="Top" Background="{Binding Color}">
            <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold" Foreground="#16161A"/>
          </Border>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Border x:Name="Root" CornerRadius="9" Background="#B8131317" BorderBrush="#30FFFFFF" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
    <Border.RenderTransform><ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="216"/><ColumnDefinition/></Grid.ColumnDefinitions>

      <!-- Barra lateral -->
      <Border Background="#33000000" CornerRadius="9,0,0,9">
        <DockPanel Margin="14,16,14,14">
          <!-- Marca do Aura (mesmo desenho do ícone) + título -->
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,8,0,20">
            <Grid Width="26" Height="26" Margin="0,0,10,0">
              <Ellipse Fill="{StaticResource AuraGrad}"/>
              <Path Data="M 8.4,16.5 A 6,6 0 1 1 17.6,16.5" Stroke="White" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Grid>
            <TextBlock Text="Rede" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock x:Name="Foot" DockPanel.Dock="Bottom" FontSize="11" Foreground="#73FFFFFF" TextWrapping="Wrap" Margin="8,0,0,0"
                     Text="Tudo é analisado no próprio PC. Nada é enviado para fora."/>
          <StackPanel>
            <RadioButton x:Name="Nav0" Style="{StaticResource Nav}" Tag="&#xE9D2;" Content="Visão geral" IsChecked="True"/>
            <RadioButton x:Name="Nav1" Style="{StaticResource Nav}" Tag="&#xE774;" Content="Conexões"/>
            <RadioButton x:Name="Nav2" Style="{StaticResource Nav}" Tag="&#xE71B;" Content="Domínios"/>
            <RadioButton x:Name="Nav3" Style="{StaticResource Nav}" Tag="&#xE72E;" Content="Portas"/>
            <RadioButton x:Name="Nav4" Style="{StaticResource Nav}" Tag="&#xE7F4;" Content="Dispositivos"/>
            <RadioButton x:Name="Nav5" Style="{StaticResource Nav}" Tag="&#xE701;" Content="Roteador"/>
            <RadioButton x:Name="Nav6" Style="{StaticResource Nav}" Tag="&#xEA18;" Content="Sites da casa"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Conteúdo -->
      <!-- Minimizar / maximizar / fechar no canto direito, na ordem do Windows -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,14,0" Panel.ZIndex="1">
        <Button x:Name="BtnMin" Style="{StaticResource WinBtn}" Content="&#xE921;" Background="#3364D2FF"/>
        <Button x:Name="BtnMax" Style="{StaticResource WinBtn}" Content="&#xE922;" Background="#40BF5AF2"/>
        <Button x:Name="BtnClose" Style="{StaticResource WinBtn}" Content="&#xE8BB;" Background="#E6FF453A"/>
      </StackPanel>

      <Grid x:Name="Content" Grid.Column="1" Margin="30,48,18,18">
        <Grid.RenderTransform><TranslateTransform x:Name="ContentShift"/></Grid.RenderTransform>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <Grid Margin="0,0,12,16">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Name="PageTitle" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock x:Name="PageHint" FontSize="13" Foreground="#A6FFFFFF" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>
          <Button x:Name="Scan" Grid.Column="1" Style="{StaticResource Pill}" Content="Procurar aparelhos" VerticalAlignment="Center" Margin="16,0,0,0" Visibility="Collapsed"/>
        </Grid>

        <!-- Visão geral -->
        <ScrollViewer x:Name="Overview" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                <StackPanel><TextBlock Style="{StaticResource Cap}" Text="DOWNLOAD AGORA (ESTE PC)"/><TextBlock x:Name="Down" Text="0 KB/s" FontSize="40" FontWeight="Light" Foreground="#64D2FF"/>
                  <TextBlock x:Name="HouseDown" FontSize="12.5" Foreground="#A6FFFFFF" Visibility="Collapsed"/></StackPanel>
              </Border>
              <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,0">
                <StackPanel><TextBlock Style="{StaticResource Cap}" Text="UPLOAD AGORA (ESTE PC)"/><TextBlock x:Name="Up" Text="0 KB/s" FontSize="40" FontWeight="Light" Foreground="#BF5AF2"/>
                  <TextBlock x:Name="HouseUp" FontSize="12.5" Foreground="#A6FFFFFF" Visibility="Collapsed"/></StackPanel>
              </Border>
            </Grid>
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Height="150">
              <Grid>
                <TextBlock Style="{StaticResource Cap}" Text="ÚLTIMO MINUTO"/>
                <TextBlock x:Name="Peak" Style="{StaticResource Cap}" HorizontalAlignment="Right"/>
                <Grid x:Name="GraphHost" Margin="0,24,0,0" ClipToBounds="True">
                  <Polyline x:Name="GUp" Stroke="#BF5AF2" StrokeThickness="2" StrokeLineJoin="Round"/>
                  <Polyline x:Name="GDown" Stroke="#64D2FF" StrokeThickness="2" StrokeLineJoin="Round"/>
                </Grid>
              </Grid>
            </Border>
            <UniformGrid Columns="3" Margin="-6,12,-6,0">
              <Border Style="{StaticResource Card}" Margin="6,0"><StackPanel><TextBlock Style="{StaticResource Cap}" Text="DESDE QUE LIGOU"/><TextBlock x:Name="TSession" FontSize="15" Margin="0,6,0,0" LineHeight="23"/></StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="6,0"><StackPanel><TextBlock Style="{StaticResource Cap}" Text="HOJE"/><TextBlock x:Name="TToday" FontSize="15" Margin="0,6,0,0" LineHeight="23"/></StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="6,0"><StackPanel><TextBlock Style="{StaticResource Cap}" Text="ESTE MÊS"/><TextBlock x:Name="TMonth" FontSize="15" Margin="0,6,0,0" LineHeight="23"/></StackPanel></Border>
            </UniformGrid>
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Width="14" Height="14" Fill="#98989F" VerticalAlignment="Top" Margin="0,5,14,0"/>
                <StackPanel Grid.Column="1">
                  <TextBlock x:Name="Status" Text="Analisando a rede…" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock x:Name="StatusDetail" FontSize="12.5" Foreground="#A6FFFFFF" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
              </Grid>
            </Border>
            <TextBlock Style="{StaticResource Cap}" Text="QUEM TRADUZ OS NOMES DOS SITES (DNS)" Margin="4,20,0,8"/>
            <ItemsControl x:Name="DnsList" ItemTemplate="{StaticResource RowT}"/>
          </StackPanel>
        </ScrollViewer>

        <!-- Listas (Conexões, Domínios, Portas, Dispositivos) -->
        <ScrollViewer x:Name="ListScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0" Visibility="Collapsed">
          <StackPanel>
            <!-- Sites da casa: ligação com o NextDNS (só aparece nessa aba, enquanto não há chave salva) -->
            <Border x:Name="NdCard" Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Style="{StaticResource Cap}" Text="LIGAR AO NEXTDNS"/>
                <TextBlock FontSize="12.5" Foreground="#A6FFFFFF" TextWrapping="Wrap" Margin="0,6,0,12"
                           Text="Para ver aqui o histórico do NextDNS (funciona mesmo com o PC desligado). Em my.nextdns.io: o ID do perfil fica na aba Configuração; a chave da API em Conta → API. A chave fica guardada só neste PC, protegida pelo Windows. O Aura só lê o histórico."/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,10,0">
                    <TextBlock FontSize="11.5" Foreground="#8CFFFFFF" Text="ID do perfil" Margin="2,0,0,4"/>
                    <TextBox x:Name="NdProfile" Style="{StaticResource Field}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock FontSize="11.5" Foreground="#8CFFFFFF" Text="Chave da API" Margin="2,0,0,4"/>
                    <PasswordBox x:Name="NdKey" Style="{StaticResource PField}"/>
                  </StackPanel>
                  <Button x:Name="NdSave" Grid.Column="2" Style="{StaticResource Pill}" Content="Ligar" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                </Grid>
              </StackPanel>
            </Border>
            <ItemsControl x:Name="List" ItemTemplate="{StaticResource RowT}"/>
            <Button x:Name="NdForget" Style="{StaticResource Pill}" Content="Desligar do NextDNS" HorizontalAlignment="Left" Margin="0,4,0,0" Visibility="Collapsed"/>
          </StackPanel>
        </ScrollViewer>

        <!-- Roteador: login (só aparece sem login salvo) + informações lidas -->
        <ScrollViewer x:Name="RouterScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0" Visibility="Collapsed">
          <StackPanel>
            <Border x:Name="RouterLogin" Style="{StaticResource Card}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Style="{StaticResource Cap}" Text="ENTRAR NO PAINEL DO ROTEADOR"/>
                <TextBlock FontSize="12.5" Foreground="#A6FFFFFF" TextWrapping="Wrap" Margin="0,6,0,12"
                           Text="A senha fica guardada só neste PC, protegida pelo Windows (só o seu usuário consegue abrir). O Aura apenas lê informações: nunca muda nada no roteador."/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,10,0">
                    <TextBlock FontSize="11.5" Foreground="#8CFFFFFF" Text="Usuário" Margin="2,0,0,4"/>
                    <TextBox x:Name="RUser" Style="{StaticResource Field}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock FontSize="11.5" Foreground="#8CFFFFFF" Text="Senha" Margin="2,0,0,4"/>
                    <PasswordBox x:Name="RPass" Style="{StaticResource PField}"/>
                  </StackPanel>
                  <Button x:Name="RSave" Grid.Column="2" Style="{StaticResource Pill}" Content="Entrar" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                </Grid>
              </StackPanel>
            </Border>
            <!-- Estado da leitura do painel: etapa atual com barra animada, hora da última leitura ou o erro -->
            <Border x:Name="RState" Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="Collapsed">
              <StackPanel>
                <TextBlock x:Name="RStateText" FontSize="12.5" Foreground="#D9FFFFFF" TextWrapping="Wrap"/>
                <ProgressBar x:Name="RBar" Height="3" IsIndeterminate="True" Margin="0,8,0,0" Foreground="{StaticResource AuraGrad}" Background="#14FFFFFF" BorderThickness="0"/>
              </StackPanel>
            </Border>
            <ItemsControl x:Name="RouterList" ItemTemplate="{StaticResource RowT}"/>
            <Button x:Name="RForget" Style="{StaticResource Pill}" Content="Esquecer login do roteador" HorizontalAlignment="Left" Margin="0,4,0,0" Visibility="Collapsed"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Border>
</Window>
